<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
         version="5.0">
  <display-name>domatar</display-name>

  <context-param>
      <param-name>DbConnection</param-name>
      <param-value>jdbc:mysql://db/domatar?user=root&amp;password=domatar</param-value>
  </context-param>

  <!--
    AppLoader discovers all JARs in WEB-INF/apps/, reads each app.manifest,
    and registers handlers and Wui servlets programmatically.
  -->
  <listener>
      <listener-class>com.domatar.app.AppLoader</listener-class>
  </listener>

  <!--
    DomatarSetupServlet extends PlatformSetupServlet and overrides
    doProviderBootstrap() to call DomatarProviderInstall.install().
    DomatarProviderInstall now uses AppRegistry for per-app install
    calls (no direct per-app imports).
  -->
  <servlet>
      <servlet-name>Setup</servlet-name>
      <servlet-class>com.domatar.servlet.DomatarSetupServlet</servlet-class>
  </servlet>
  <servlet-mapping>
      <servlet-name>Setup</servlet-name>
      <url-pattern>/Setup</url-pattern>
  </servlet-mapping>

  <welcome-file-list>
      <welcome-file>index.html</welcome-file>
  </welcome-file-list>
</web-app>

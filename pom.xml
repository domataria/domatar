<?xml version="1.0" encoding="UTF-8"?>
<!--
  ~ Copyright (c) 2024 Domatar
  -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.domatar</groupId>
    <artifactId>domatar</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Domatar Parent</name>
    <description>Parent POM for the Domatar multi-module build</description>

    <modules>
        <module>platform/core</module>
        <module>apps/navigator</module>
        <module>apps/login</module>
        <module>apps/desktop</module>
        <module>apps/quippin</module>
        <module>apps/bookstore</module>
        <module>apps/spreadsheet</module>
        <module>apps/money</module>
        <module>apps/canton</module>
        <module>apps/search</module>
        <module>apps/chat</module>
        <module>apps/mail</module>
        <module>apps/aiagent</module>
        <module>apps/appstore</module>
        <module>platform/app</module>
        <module>platform/war</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.domatar</groupId>
                <artifactId>domatar-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.domatar</groupId>
                <artifactId>navigator</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.domatar</groupId>
                <artifactId>login</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.domatar</groupId>
                <artifactId>desktop</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.domatar</groupId>
                <artifactId>quippin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.domatar</groupId>
                <artifactId>bookstore</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.domatar</groupId>
                <artifactId>spreadsheet</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.domatar</groupId>
                <artifactId>money</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.domatar</groupId>
                <artifactId>canton</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.domatar</groupId>
                <artifactId>search</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.domatar</groupId>
                <artifactId>chat</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.domatar</groupId>
                <artifactId>mail</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.domatar</groupId>
                <artifactId>aiagent</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.domatar</groupId>
                <artifactId>appstore</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.domatar</groupId>
                <artifactId>domatar-app</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.servlet</groupId>
                <artifactId>jakarta.servlet-api</artifactId>
                <version>6.0.0</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>9.1.0</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>5.11.4</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-war-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
